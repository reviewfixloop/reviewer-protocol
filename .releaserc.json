{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      { "preset": "conventionalcommits", "releaseRules": [{ "type": "docs", "release": "patch" }] }
    ],
    [
      "@semantic-release/release-notes-generator",
      { "parserOpts": { "headerPattern": "^(\\w*)(?:\\((.*)\\))?!?: (.*)$" } }
    ],
    "@semantic-release/npm",
    [
      "@semantic-release/github",
      { "labels": false, "releasedLabels": false, "successCommentCondition": false, "failCommentCondition": false }
    ]
  ]
}
